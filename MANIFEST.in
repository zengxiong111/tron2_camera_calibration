include LICENSE README.md README.zh-CN.md
recursive-include sp_vision *.py
recursive-include sp_vision/configs *.example.json *.urdf *.xml
recursive-include scripts *.py *.sh
recursive-include .github *.yml
exclude sp_vision/configs/head_config.json
exclude sp_vision/configs/wrist_config.json
exclude sp_vision/configs/robot_profile.json
prune build
prune dist
prune .venv
